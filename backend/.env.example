PORT=4000
# The admin web origin allowed by CORS (explicit, no wildcard).
APP_ORIGIN=http://localhost:3000
# Optional: more allowed origins, comma separated.
# APP_ORIGINS_EXTRA=
# Local Docker Postgres (docker compose service `postgres`, host port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/gym
# Test DB for `bun test`. The database name must end in _test and differ from DATABASE_URL.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/gym_test
# Generate each with: openssl rand -base64 48   (the two must differ, 32+ chars)
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string-for-access-tokens
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string-for-refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
