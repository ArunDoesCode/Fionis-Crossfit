PORT=4000
# The app's one public address (same origin as /api, D-018): a write must send it as its Origin header (BR-REC-37). No CORS.
APP_ORIGIN=http://localhost:3000
# Optional: more addresses a write may come from, comma separated.
# APP_ORIGINS_EXTRA=
# Local Docker Postgres (docker compose service `postgres`, host port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/gym
# Test DB for `bun test`. The database name must end in _test and differ from DATABASE_URL.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/gym_test
# Generate each with: openssl rand -base64 48   (the two must differ, 32+ chars)
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string-for-access-tokens
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string-for-refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Sign-in without "Keep me signed in" ends on the server after this long (12 h). Optional.
SESSION_SHORT_TTL_SECONDS=43200
# Rate limits (login 10/min, refresh 30/min) are per network address. This says how many proxies in
# front of the API append the caller's address to X-Forwarded-For; the limiter reads that many entries
# from the right and never trusts anything the browser put on the left (spoofed entries are ignored).
#   0 = ignore the header, use the connecting address. Local dev: Next.js forwards /api and is the only
#       caller, so everyone shares one address. Safe default; in production it makes all users share one limit.
#   1 = production on the D-018 chain (browser -> HTTPS front -> Next.js -> API): only the HTTPS front
#       appends an entry; Next.js rewrites pass the header through unchanged (checked in Next 16.3.6).
# Verify on the real server by sending a fake X-Forwarded-For and checking that the limit does not change.
TRUST_PROXY_HOPS=0
