{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "bun test",
    "db:push": "bun drizzle-kit push",
    "db:reset": "bun scripts/db-reset.ts",
    "db:test:prepare": "bun scripts/prepare-test-db.ts",
    "seed": "bun scripts/seed.ts",
    "seed:perf": "bun scripts/seed-perf.ts",
    "seed:demo": "bun scripts/seed-demo.ts",
    "bootstrap-admin": "bun scripts/bootstrap-admin.ts",
    "contract:generate": "bun scripts/generate-api-manifest.ts",
    "contract:check": "bun scripts/generate-api-manifest.ts --check",
    "contract:query": "bun scripts/query-api-manifest.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
