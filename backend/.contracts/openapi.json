{
  "openapi": "3.1.0",
  "info": {
    "title": "Gym app API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getApiHealth",
        "tags": [
          "health"
        ],
        "summary": "Liveness and database connectivity probe",
        "description": "503 is returned when the database is unreachable (db: 'down').",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "degraded"
                          ]
                        },
                        "db": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "db"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "degraded"
                          ]
                        },
                        "db": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "db"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "x-auth": {
          "type": "public"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
