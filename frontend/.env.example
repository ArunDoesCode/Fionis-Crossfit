# Browser -> backend base URL (public; inlined at build time). Same origin (D-018): a path, not a full URL.
# Next forwards /api/* to API_URL (see next.config.ts), so there is no CORS and cookies are first-party.
NEXT_PUBLIC_API_URL=/api
# Server -> backend base URL (server-only, internal address; ends in /api like the backend routes).
# Also the target of the /api rewrite, which is resolved at `next build`, so set it for the build too.
API_URL=http://localhost:4000/api
